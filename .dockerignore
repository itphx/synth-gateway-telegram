# Контекст сборки Docker-образа (см. docker/Dockerfile).
# Внутрь образа попадают только манифесты и исходники — без секретов, данных и git.
# Исключение: `addon.json` и `skills/` копируются в runtime-образ (манифест
# `provides` + скиллы нужны hook-Job'у авто-установки).

.git
.gitverse
node_modules
dist
tmp
data
secrets
certs
charts
docs
examples
*.log
*.tsbuildinfo
**/*.test.ts
docker-compose.yml
.dockerignore
.gitignore
.editorconfig
.prettierrc
eslint.config.js
vitest.config.ts
README.md
AGENTS.md
LICENSE
