# Зависимости
node_modules/

# Сборка
dist/
*.tsbuildinfo

# Runtime-данные (JSON-хранилище шлюза) и временные файлы
data/
tmp/

# Секреты — вне git (токен бота, ключи Synth, tenants.json); см. docs/configuration.md
secrets/

# Внутренний CA не хранится в шлюзе; положите свой локально (certs/ca.crt)
certs/

# Тесты и логи
coverage/
*.log

# Окружение
.env
.env.*
!.env.example
