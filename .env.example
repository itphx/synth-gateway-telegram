# Пример окружения Telegram-шлюза для `docker compose`.
# Скопируйте в `.env` (вне git) и заполните значения. Секреты можно не задавать
# здесь, а положить файлами в `secrets/` (ro-mount `./secrets:/run/secrets`).
# Пустая строка = значение не задано.
#
# Полный справочник переменных, CLI-флагов, приоритетов, режимов аутентификации
# и мультитенантности — docs/configuration.md.

# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен бота (или файл secrets/telegram_bot_token). Без него — dry-run.
TELEGRAM_BOT_TOKEN=
# Egress-прокси Bot API: http(s)://… (CONNECT) или socks5://… (файл secrets/telegram_proxy_url).
TELEGRAM_PROXY_URL=

# ─── Synth API v2 ────────────────────────────────────────────────────────────
SYNTH_URL=http://host.docker.internal:5000/api/v2

# Доверие внутреннему CA (внешний https-инстанс Synth): bundle root+intermediate
# (root первым) как certs/ca.crt (вне git); в compose монтируется в /certs/ca.crt.
NODE_EXTRA_CA_CERTS=

# Приоритет аутентификации: service-key > OIDC > SYNTH_API_KEY > без auth.
# Scoped service-key `synth_svc_…` (AD-052) — рекомендуется; или файл secrets/synth_service_key.
SYNTH_SERVICE_KEY=
# Legacy-fallback (standalone/dev) или файл secrets/synth_api_key.
SYNTH_API_KEY=
# OIDC client-credentials (managed) — приоритетнее SYNTH_API_KEY.
SYNTH_OIDC_TOKEN_URL=
SYNTH_OIDC_DISCOVERY_URL=
SYNTH_OIDC_CLIENT_ID=
SYNTH_OIDC_CLIENT_SECRET=
SYNTH_OIDC_SCOPE=

# ─── Шлюз ────────────────────────────────────────────────────────────────────
# Список доступа chatId:ROLE через запятую (или файл secrets/allowlist.json).
GATEWAY_ALLOWLIST=
# Мультитенантность: файл «боты → среды Synth» (или secrets/tenants.json).
# Пусто = автопоиск; нет файла = один тенант default из env/CLI.
GATEWAY_TENANTS_FILE=
# Политика неизвестного отправителя: register (дефолт) | hint | reject.
GATEWAY_UNKNOWN_ACTION=register
# Отправка ответов: plain (дефолт) | html.
GATEWAY_PARSE_MODE=plain

# ─── MCP по HTTP (второй процесс/контейнер) ──────────────────────────────────
# Bearer-токен клиентов HTTP-MCP (`node dist/mcp/index.js --http`), или файл
# secrets/mcp_token. Без токена HTTP-режим не стартует. Секрет — не в git!
GATEWAY_MCP_TOKEN=
# Адрес/порт HTTP-MCP (дефолты: 0.0.0.0:7101); путь запроса — /mcp/<tenantId>.
GATEWAY_MCP_HOST=0.0.0.0
GATEWAY_MCP_PORT=7101

# ─── Авто-установка ресурсов в Synth (scripts/install-into-synth.mjs) ────────
# Машинный ключ инсталлятора (service-key, scope addons:install; пока — ADMIN).
# В кластере приходит из Secret (hook-Job), локально — отсюда или флагом --token.
SYNTH_INSTALL_TOKEN=
# Bearer-токен MCP-клиентов add-on'а (`--mcp-token`): уходит в
# config.headers.Authorization записи реестра — Synth-MCP-клиент авторизуется им
# при подключении к /mcp/<tenant>. В кластере приходит из Secret (hook-Job).
SYNTH_MCP_TOKEN=
# Тенант (подстановка {tenant} в provides.mcp.path) и хост для сборки MCP-URL.
SYNTH_ADDON_TENANT=
# Базовый URL MCP-эндпоинта (альтернатива --service-host).
SYNTH_ADDON_MCP_URL=
# Host сервиса add-on'а: MCP-URL собирается как http://<host>:<provides.mcp.port><path>.
SYNTH_ADDON_SERVICE_HOST=
